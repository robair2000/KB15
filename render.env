# Environment variables for the Render background worker.
# On every push to main, .github/workflows/render-env.yml copies each line below onto the worker
# and then starts a deploy. Edit a value here, commit, push -> it is live on Render.
#
# NEVER put the KuCoin keys in this file (the repo is not a safe place for secrets).
# Set KUCOIN_API_KEY, KUCOIN_API_SECRET and KUCOIN_PASSPHRASE once by hand in the Render
# dashboard (Environment tab). The sync only touches the keys listed here, so it leaves them alone.
# Removing a line here does NOT delete the variable on Render; delete it in the dashboard.

# --- mode ---
MODE=live
CONFIRM_LIVE=YES_I_ACCEPT_THE_RISK
MARKET=futures
PYTHON_VERSION=3.11.9
STATE_PATH_FUTURES=/data/state_futures_sub.json

# --- model / timing ---
KRONOS_MODEL=mini
INTERVAL=1hour
FORECAST_BATCH=2
ENTRY_THRESHOLD=0.008

# --- coins ---
PAIRS=ETH-USDT,SOL-USDT,ZEC-USDT,IRYS-USDT,XRP-USDT,NEAR-USDT,XMR-USDT,USELESS-USDT,ASTER-USDT,LINK-USDT,ADA-USDT,DOGE-USDT

# --- risk & sizing ---
RISK_FRAC=0.01
MAX_LEVERAGE=3
MAX_MARGIN_FRAC=0.25
MAX_POSITIONS=8
MAX_SAME_SIDE=5
DAILY_LOSS_LIMIT=0.2

# --- stops: ATR-based per coin (STOP_PCT / TAKE_PCT are only used if ATR_STOPS=false) ---
ATR_STOPS=true
ATR_PERIOD=14
ATR_STOP_MULT=2.0
ATR_STOP_MIN=0.01
ATR_STOP_MAX=0.08
ATR_TP_RR=1.5
STOP_PCT=0.03
TAKE_PCT=0.03

# --- RSI filter ---
RSI_FILTER=true
RSI_PERIOD=14
RSI_LONG_MAX=85
RSI_SHORT_MIN=35

# --- open-interest filter ---
OI_FILTER=true
OI_EXCHANGE=binance
OI_PERIOD=5m
OI_REQUIRED=false
OI_LOOKBACK_BARS=4
OI_MIN_CHANGE=0.01
OI_SPIKE_MODE=avoid
OI_SPIKE_BARS=2
OI_SPIKE_MIN_PCT=0.005
OI_SPIKE_WINDOW=100
OI_SPIKE_Z=3.0
